+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { freezeOwnedData, OwnedDataCopier, UnsupportedOwnedData, type DescriptorTemplates } from '../src/geometry/owned-data';
+
+test('joint copies retain cycles, shared aliases, property order and sparse slots without freezing caller data', () => {
+  const shared = { x: 1 }, input: any = { first: shared, second: shared, sparse: new Array(3) };
+  input.self = input; input.sparse[2] = shared;
+  const copy = new OwnedDataCopier().copy(input);
+  assert.notStrictEqual(copy, input); assert.strictEqual(copy.first, copy.second);
+  assert.strictEqual(copy.self, copy); assert.strictEqual(copy.sparse[2], copy.first);
+  assert.equal(0 in copy.sparse, false); assert.deepEqual(Object.keys(copy), Object.keys(input));
+  const templates: DescriptorTemplates = new WeakMap(); freezeOwnedData(copy, templates);
+  assert(Object.isFrozen(copy.first)); assert.equal(Object.isFrozen(shared), false);
+  shared.x = 4; assert.equal(copy.first.x, 1);
+  const view = new OwnedDataCopier(templates).copy(copy);
+  view.first.x = 7; view.sparse.push(view.first);
+  assert.strictEqual(view.first, view.second); assert.strictEqual(view.sparse[3], view.first);
+  assert.equal(copy.first.x, 1); assert.equal(view.sparse.length, 4);
+});
+
+test('non-enumerable flags survive freezing and mutable escape; caller frozen flags are preserved', () => {
+  const input: any = { ordinary: { value: 1 } };
+  Object.defineProperty(input, 'hidden', { value: input.ordinary, enumerable: false, writable: true, configurable: true });
+  Object.defineProperty(input, 'fixed', { value: 9, enumerable: true, writable: false, configurable: false });
+  const templates: DescriptorTemplates = new WeakMap(), copy = new OwnedDataCopier().copy(input);
+  freezeOwnedData(copy, templates); const view = new OwnedDataCopier(templates).copy(copy);
+  assert.strictEqual(view.hidden, view.ordinary); view.hidden = { value: 2 };
+  assert.deepEqual(Object.getOwnPropertyDescriptor(view, 'hidden'), { value: view.hidden, enumerable: false, writable: true, configurable: true });
+  assert.throws(() => { view.fixed = 10; }, TypeError);
+  assert.deepEqual(Object.keys(view), ['ordinary', 'fixed']);
+});
+
+test('accessors and non-data inputs are rejected without executing an accessor', () => {
+  let reads = 0; const accessor = { get x() { reads++; return 1; } };
+  for (const value of [accessor, new Map(), new Date(), { fn() {} }, { key: Symbol('x') }, { big: 1n }, { [Symbol.iterator]: undefined }]) {
+    assert.throws(() => new OwnedDataCopier().copy(value), UnsupportedOwnedData);
+  }
+  assert.equal(reads, 0);
+});
