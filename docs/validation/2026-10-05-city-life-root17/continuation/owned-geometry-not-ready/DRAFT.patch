+/** Copies ordinary parameter/geometry data without invoking accessors. The
+ * caller decides whether an unsupported graph retains its existing live path. */
+export class UnsupportedOwnedData extends Error {}
+export type DescriptorTemplates = WeakMap<object, PropertyDescriptorMap>;
+
+export class OwnedDataCopier {
+  readonly copies = new Map<object, object>();
+  constructor(private readonly restore?: DescriptorTemplates) {}
+
+  copy<T>(value: T): T {
+    if (value === null || typeof value !== 'object') {
+      if (typeof value === 'function' || typeof value === 'symbol' || typeof value === 'bigint') throw new UnsupportedOwnedData('non-data value');
+      return value;
+    }
+    const old = this.copies.get(value); if (old) return old as T;
+    const array = Array.isArray(value), prototype = Object.getPrototypeOf(value);
+    if (prototype !== (array ? Array.prototype : Object.prototype) && !(prototype === null && !array)) throw new UnsupportedOwnedData('non-ordinary object');
+    const descriptors = Object.getOwnPropertyDescriptors(value);
+    if (Reflect.ownKeys(descriptors).some(key => typeof key !== 'string')) throw new UnsupportedOwnedData('symbol member');
+    const result = array ? [] : Object.create(prototype);
+    this.copies.set(value, result);
+    const templates = this.restore?.get(value);
+    for (const key of Object.keys(descriptors)) {
+      const descriptor = descriptors[key];
+      if (!('value' in descriptor)) throw new UnsupportedOwnedData('accessor');
+      const original = templates?.[key] ?? descriptor;
+      Object.defineProperty(result, key, { value: this.copy(descriptor.value), enumerable: original.enumerable, writable: original.writable, configurable: original.configurable });
+    }
+    return result as T;
+  }
+}
+
+/** Only call for the factory's copied graph or data created from that graph.
+ * Keep original descriptor flags so a later public mutable escape can retain
+ * the original writable objects and all shared aliases. */
+export function freezeOwnedData<T>(value: T, templates: DescriptorTemplates, seen = new Set<object>()): T {
+  if (value === null || typeof value !== 'object' || seen.has(value)) return value;
+  seen.add(value);
+  const array = Array.isArray(value), prototype = Object.getPrototypeOf(value);
+  if (prototype !== (array ? Array.prototype : Object.prototype) && !(prototype === null && !array)) throw new UnsupportedOwnedData('non-ordinary owned graph');
+  const descriptors = Object.getOwnPropertyDescriptors(value);
