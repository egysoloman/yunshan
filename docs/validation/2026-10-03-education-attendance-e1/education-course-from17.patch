+  // sized aggregate totals. The existing money assertion tolerance is retained.
+  const difference = [...new Set([...before.keys(), ...after.keys()])]
+    .reduce((sum, id) => sum + ((after.get(id) ?? 0) - (before.get(id) ?? 0)), 0);
+  close(difference, 0, label);
+}
