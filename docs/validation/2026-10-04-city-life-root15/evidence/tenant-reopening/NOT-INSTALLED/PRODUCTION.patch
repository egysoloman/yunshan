+export const TENANT_SHOP_CONTINUITY_POLICY = 'tenant-distress-v1' as const;
+export type ShopContinuityPolicy = typeof TENANT_SHOP_CONTINUITY_POLICY;
+
+export function hasShopContinuityDeclaration(data: Record<string, any>): boolean {
+  return Object.hasOwn(data, 'shopContinuityPolicyId') || !!data.runtime && Object.hasOwn(data.runtime, 'shopContinuityPolicyId')
+    || Array.isArray(data.state?.shopLifecycle?.receipts) && data.state.shopLifecycle.receipts.some((row: unknown) =>
+      !!row && typeof row === 'object' && (Reflect.get(row, 'kind') === 'tenant-distress' || Object.hasOwn(row, 'tenantDecision')));
+}
+
+/** Only this explicit current-city policy extends ordinary tenant choice.
+ * An old save lacking both declarations keeps the original owner-only rule. */
+export function validateShopContinuityPolicy(data: Record<string, any>): void {
+  const envelope = Object.hasOwn(data, 'shopContinuityPolicyId');
+  const runtime = !!data.runtime && Object.hasOwn(data.runtime, 'shopContinuityPolicyId');
+  if (!hasShopContinuityDeclaration(data)) return;
+  if (!envelope || !runtime || data.shopContinuityPolicyId !== TENANT_SHOP_CONTINUITY_POLICY
+    || data.runtime.shopContinuityPolicyId !== TENANT_SHOP_CONTINUITY_POLICY
+    || data.version !== 4 || data.rulesetId !== 'civic-local-v1' || data.motionVersion !== 2
+    || data.historyPolicyId !== 'civic-history-pages-v1' || data.runtime.npcMotionVersion !== 2
+    || data.runtime.civicHistoryVersion !== 1 || data.state?.civicHistory?.version !== 1
+    || data.state.civicHistory.policyId !== 'civic-history-pages-v1') throw new Error('无效存档字段：shop continuity policy pair。');
+}
