diff --git a/tests/helpers/located-freight-world.ts b/tests/helpers/located-freight-world.ts
new file mode 100644
index 0000000..12986a4
--- /dev/null
+++ b/tests/helpers/located-freight-world.ts
@@ -0,0 +1,19 @@
+import type { Building, WorldDefinition } from '../../src/types';
+
+// Small trusted generated fleet: the two road freight carriers start with the
+// model's ordinary 28 units each. Tests never add stock or a new vehicle ID.
+export function locatedFreightWorld(): WorldDefinition {
+  const buildings: Building[] = (['farm', 'market', 'home'] as const).map((kind, i) => ({
+    id: kind, kind, name: kind, districtId: i ? 'customers' : 'growers',
+    position: { x: i * 300, y: 20, z: 0 }, door: { x: i * 300, y: 20, z: 5 },
+    width: 10, depth: 10, height: 8, floors: 1, rotation: 0, capacity: 80, seed: i,
+  }));
+  const nodes = buildings.map(b => ({ id: b.id + '-door', districtId: b.districtId, name: b.name, position: { ...b.door }, station: true }));
+  return { seed: 20261001, voxelSize: .2, size: 1600, buildings, nodes,
+    edges: [{ id: 'food-road', from: nodes[0].id, to: nodes[1].id, mode: 'road', length: 300, capacity: 20, points: [nodes[0].position, nodes[1].position] },
+      { id: 'home-road', from: nodes[1].id, to: nodes[2].id, mode: 'road', length: 300, capacity: 20, points: [nodes[1].position, nodes[2].position] }],
+    mountains: [], districts: [
+      { id: 'growers', name: 'growers', kind: 'river', center: { x: 0, y: 20, z: 0 }, radius: 300, color: '#aaa', population: 12 },
+      { id: 'customers', name: 'customers', kind: 'market', center: { x: 450, y: 20, z: 0 }, radius: 400, color: '#bbb', population: 12 }],
+    spawn: { ...buildings[2].door }, waterfall: { top: { x: 900, y: 50, z: 0 }, bottom: { x: 900, y: 20, z: 0 }, width: 10 }, river: [] };
+}
diff --git a/tests/located-freight.test.ts b/tests/located-freight.test.ts
new file mode 100644
index 0000000..5d543d2
--- /dev/null
+++ b/tests/located-freight.test.ts
@@ -0,0 +1,177 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { readFileSync } from 'node:fs';
+import { gunzipSync } from 'node:zlib';
+import { Simulation } from '../src/simulation';
+import { locatedFreightWorld } from './helpers/located-freight-world';
+
+const world = locatedFreightWorld();
+const runtime = (sim: Simulation): any => Reflect.get(sim, 'runtime');
+function cash(sim: Simulation) {
+  const s = sim.state, e = s.extension!;
+  return s.treasury + runtime(sim).taxes + s.player.money + s.banking!.cash + s.banking!.legacyInvestmentCash
+    + s.citizens.reduce((n, c) => n + c.money, 0) + (s.playerLabor?.job?.escrow ?? 0)
+    + (s.clinical?.orders.reduce((n, order) => n + order.escrow, 0) ?? 0)
+    + (s.family?.pregnancies.reduce((n, p) => n + p.escrow, 0) ?? 0)
+    + (s.family?.households.reduce((n, h) => n + h.balance, 0) ?? 0)
+    + s.shops.filter(shop => !e.companies.some(c => c.buildingId === shop.buildingId)).reduce((n, shop) => n + (shop.cash ?? 0), 0)
+    + e.companies.reduce((n, c) => n + c.capital, 0) + e.organizations.reduce((n, o) => n + o.funds, 0);
+}
+function goods(sim: Simulation) {
+  return sim.state.shops.filter(shop => sim.shopCommodity(shop) === 'food').reduce((n, shop) => n + shop.inventory, 0)
+    + sim.state.vehicles.reduce((n, v) => n + v.cargo, 0) + Object.values(runtime(sim).freight as Record<string, number>).reduce((n, q) => n + q, 0)
+    + sim.state.citizens.reduce((n, c) => n + (c.food ?? 0), 0) + (sim.state.player.inventory.food ?? 0);
+}
+function prepare(sim = new Simulation(world)) {
+  for (const v of sim.state.vehicles) v.nextDeparture = 1e6;
+  for (const c of sim.state.citizens) { c.needs = { hunger: 100, fatigue: 100, social: 100, fun: 100 }; runtime(sim).activities[c.id] = 'social'; runtime(sim).decisionAt[c.id] = 1e6; }
+  sim.command({ type: 'speed', value: 8 });
+  return sim;
+}
+function approach(sim: Simulation, id: string, direction: 1 | -1) {
+  const vehicle = sim.state.vehicles.find(v => v.id === id)!;
+  vehicle.progress = direction === 1 ? .999 : .001; vehicle.direction = direction; vehicle.nextDeparture = sim.state.day * 1440 + sim.state.hour * 60;
+  const edge = world.edges.find(e => e.id === vehicle.edgeId)!;
+  runtime(sim).signalOverrides[direction === 1 ? edge.to : edge.from] = direction === 1 ? 1 : 0;
+  return vehicle;
+}
+function restore(sim: Simulation) {
+  const save = sim.exportSave(), restored = new Simulation(world), result = restored.importSave(save);
+  assert.equal(result.ok, true, result.message); assert.equal(restored.exportSave(), save);
+  return restored;
+}
+function verifyLots(sim: Simulation) {
+  const r = runtime(sim), ids = new Set<string>();
+  for (const [districtId, lots] of Object.entries(r.freightLots) as [string, any[]][]) {
+    assert.ok(Math.abs(lots.reduce((n, lot) => n + lot.quantity, 0) - (r.freight[districtId] ?? 0)) < 1e-8);
+    for (const lot of lots) { assert.ok(!ids.has(lot.id)); ids.add(lot.id); const origin = r.freightTracking.origins[lot.id]; assert.equal(origin.shopId, lot.shopId); assert.equal(origin.districtId, districtId); assert.ok(lot.quantity <= origin.receivedQuantity); }
+  }
+  assert.deepEqual(Object.keys(r.freightTracking.origins).sort(), [...ids].sort());
+}
+
+function twoNodes() {
+  const sim = prepare();
+  approach(sim, 'vehicle-food-road-1', 1); approach(sim, 'vehicle-home-road-1', 1);
+  sim.step(.25);
+  return sim;
+}
+
+test('actual two-node unloads keep separate same-owner FIFO lots and conserve original goods and cash', () => {
+  const sim = prepare(), initialCash = cash(sim), initialGoods = goods(sim), cargo = sim.state.vehicles.reduce((n, v) => n + v.cargo, 0);
+  const passengers = new Map(sim.state.vehicles.map(v => [v.id, v.passengers]));
+  const events: any[] = [];
+  sim.onEvent('cargo-arrived', event => { events.push(structuredClone(event)); const v = sim.state.vehicles.find(v => v.id === event.vehicleId)!; assert.equal(v.cargo, 0, 'native cargo has left the vehicle when receipt is visible'); assert.equal(v.passengers, passengers.get(v.id), 'unloading itself cannot evict passengers'); });
+  approach(sim, 'vehicle-food-road-1', 1); approach(sim, 'vehicle-home-road-1', 1); sim.step(.25);
+  assert.equal(events.length, 2); assert.deepEqual(events.map(e => e.nodeId), ['market-door', 'home-door']);
+  assert.equal(sim.state.vehicles.reduce((n, v) => n + v.cargo, 0), cargo - 56);
+  assert.equal(runtime(sim).freight.customers, 56);
+  const lots = runtime(sim).freightLots.customers;
+  assert.deepEqual(lots.map((lot: any) => [lot.shopId, lot.quantity]), [[null, 28], [null, 28]]);
+  for (let i = 0; i < lots.length; i++) {
+    const proof = runtime(sim).freightTracking.origins[lots[i].id];
+    assert.equal(proof.location, 'node'); assert.equal(proof.nodeId, events[i].nodeId); assert.equal(proof.vehicleId, events[i].vehicleId);
+    assert.equal(proof.fromEdgeId, events[i].fromEdgeId); assert.equal(proof.direction, 1); assert.equal(proof.arrivedAt, events[i].arrivedAt); assert.deepEqual(proof.position, events[i].position);
+  }
+  // The following people phase may legitimately board new riders. The exact
+  // unload boundary above verifies that freight itself never changes seats.
+  assert.equal(goods(sim), initialGoods); assert.ok(Math.abs(cash(sim) - initialCash) < 1e-7);
+  verifyLots(sim); restore(sim);
+});
+
+test('a real farm pickup and subsequent native delivery retain private ownership and do not charge transport twice', () => {
+  const sim = prepare(), farm = sim.state.shops.find(shop => shop.buildingId === 'farm')!, start = farm.inventory, initialCash = cash(sim), initialGoods = goods(sim);
+  const truck = approach(sim, 'vehicle-food-road-1', -1); let loads = 0;
+  sim.onEvent('cargo-loaded', event => { if (event.vehicleId === truck.id) { assert.equal(event.nodeId, 'farm-door'); assert.equal(event.shopId, farm.id); loads++; } });
+  sim.step(.25); assert.equal(loads, 1); assert.equal(truck.cargo, 28); assert.equal(farm.inventory, start - 28); assert.equal(runtime(sim).cargoSources[truck.id], farm.id);
+  const loaded = restore(sim); const carrier = loaded.state.vehicles.find(v => v.id === truck.id)!;
+  let arrived = false; loaded.onEvent('cargo-arrived', event => { if (event.shopId === farm.id && event.nodeId === 'market-door') arrived = true; });
+  for (let i = 0; i < 160 && !arrived; i++) loaded.step(.25);
+  assert.ok(arrived, 'the actual carrier traverses its road and delivers the farm load');
+  const owned = runtime(loaded).freightLots.customers.find((lot: any) => lot.shopId === farm.id); assert.ok(owned); assert.equal(owned.quantity, 28);
