+  const nextId = runtime(sim).freightTracking.nextId;
+  for (let i = 0; i < 6; i++) sim.step(.25);
+  assert.equal(runtime(sim).freightLots.customers[0].quantity, 14); assert.equal(runtime(sim).freightLots.customers.length, 2);
+  assert.equal(sim.command({ type: 'purchase', value: 13 }).ok, true);
+  for (let i = 0; i < 6; i++) sim.step(.25);
+  assert.equal(runtime(sim).freightLots.customers[0].quantity, 28); assert.equal(runtime(sim).freightLots.customers.length, 1, 'only the exhausted first-node receipt is removed');
+  assert.equal(Object.keys(runtime(sim).freightTracking.origins).length, 1);
