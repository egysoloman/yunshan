+test('tracking identity, provenance and declaration corruptions all reject before changing the loaded city', () => {
+  const source = twoNodes(), save = source.exportSave(), target = new Simulation(world), baseline = target.exportSave();
+  const cases: [string, (s: any) => void][] = [
+    ['declaration missing', s => delete s.freightTrackingVersion], ['body missing', s => delete s.runtime.freightTracking],
+    ['sequence missing', s => delete s.runtime.freightTracking.nextId], ['sequence reuses IDs', s => s.runtime.freightTracking.nextId = 1],
+    ['FIFO body missing', s => delete s.runtime.freightLots], ['district lots missing', s => delete s.runtime.freightLots.customers],
+    ['lot ID missing', s => delete s.runtime.freightLots.customers[0].id], ['duplicate lot ID', s => s.runtime.freightLots.customers[1].id = s.runtime.freightLots.customers[0].id],
+    ['origin missing', s => delete s.runtime.freightTracking.origins[s.runtime.freightLots.customers[0].id]],
+    ['wrong known node', s => s.runtime.freightTracking.origins[s.runtime.freightLots.customers[0].id].nodeId = 'home-door'],
+    ['unknown node', s => s.runtime.freightTracking.origins[s.runtime.freightLots.customers[0].id].nodeId = 'missing'],
+    ['unknown vehicle', s => s.runtime.freightTracking.origins[s.runtime.freightLots.customers[0].id].vehicleId = 'vehicle-arbitrary'],
+    ['wrong edge', s => s.runtime.freightTracking.origins[s.runtime.freightLots.customers[0].id].fromEdgeId = 'home-road'],
+    ['wrong direction', s => s.runtime.freightTracking.origins[s.runtime.freightLots.customers[0].id].direction = -1],
+    ['future time', s => s.runtime.freightTracking.origins[s.runtime.freightLots.customers[0].id].arrivedAt = s.state.extension.lastUpdate + 1],
+    ['remote position', s => s.runtime.freightTracking.origins[s.runtime.freightLots.customers[0].id].position.x += 3],
+    ['wrong owner', s => s.runtime.freightTracking.origins[s.runtime.freightLots.customers[0].id].shopId = 'shop-farm'],
+    ['quantity exceeds receipt', s => { s.runtime.freightLots.customers[0].quantity++; s.runtime.freight.customers++; }],
+    ['district total increased', s => s.runtime.freight.customers++],
+    ['unreferenced duplicate receipt', s => s.runtime.freightTracking.origins['freight-lot-9'] = structuredClone(Object.values(s.runtime.freightTracking.origins)[0])],
+    ['located proof downgraded with fields retained', s => s.runtime.freightTracking.origins[s.runtime.freightLots.customers[0].id].location = 'legacy-district'],
+  ];
+  for (const [label, mutate] of cases) { const s = JSON.parse(save); mutate(s); assert.equal(target.importSave(JSON.stringify(s)).ok, false, label); assert.equal(target.exportSave(), baseline, `${label}: atomic rejection`); }
+});
